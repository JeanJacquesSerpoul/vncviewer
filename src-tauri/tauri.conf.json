{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VNC Viewer",
  "version": "0.1.0",
  "identifier": "io.github.vncviewer",
  "build": {
    "beforeDevCommand": "trunk serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "trunk build --release",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "VNC Viewer",
        "width": 1280,
        "height": 820,
        "minWidth": 480,
        "minHeight": 360
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Jean-Jacques Serpoul",
    "copyright": "Copyright © 2026 Jean-Jacques Serpoul",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "category": "Utility",
    "shortDescription": "VNC remote desktop viewer",
    "longDescription": "Remote desktop viewer for the VNC (RFB) protocol, written in Rust with Tauri and Leptos. French and English interface.",
    "linux": {
      "deb": {
        "section": "net"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
